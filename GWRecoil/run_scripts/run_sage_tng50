# =========================================
# SAGE Script Start
# =========================================

# 1. Compile SAGE:
     cd /Users/pater32/Documents/GitHub/sage/GWRecoil
     make clean
     make

     PARAM_FILE=input/tng50.par

# 2. Run SAGE (10 realizations):
     for run in {1..10}
     do
          echo "Starting run ${run}"

          # replace output directory in parameter file
          sed -i '' \
          "s|OutputDir.*|OutputDir              /Users/pater32/Documents/GitHub/sage/GWRecoil/output/results/illustristng/tng50_4/run${run}|g" \
          $PARAM_FILE

     ./sage --overwrite $PARAM_FILE

     done

